{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoulClient",
  "version": "0.1.0",
  "identifier": "com.soulclient.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SoulClient",
        "width": 1280,
        "height": 760,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://updates.soulclient.example/{{target}}/{{arch}}/{{current_version}}"
      ],
      "dialog": true,
      "pubkey": "REPLACE_WITH_YOUR_GENERATED_PUBLIC_KEY"
    }
  }
}
